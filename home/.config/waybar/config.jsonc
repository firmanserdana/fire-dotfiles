{
  "reload_style_on_change": true,
  "toggle": true,
  "layer": "top",
  "position": "left",
  "margin-top": 4,
  "margin-bottom": 4,
  "margin-left": 4,
  "margin-right": 0,
  "spacing": 4,
  "include": [
    "~/.config/waybar/modules.json"
  ],
  "modules-left": [
    "clock",
    "custom/updates",
    "cpu",
    "memory",
    "temperature",
    "niri/workspaces"
  ],
  "modules-center": [
    "mpris",
    "privacy"
  ],
  "modules-right": [
    "group/extras",
    "network",
    "bluetooth",
    "pulseaudio#microphone",
    "group/audio",
    "group/brightness",
    "battery",
    "idle_inhibitor",
    "custom/powermenu"
  ]
}