// #######################################################################################
// AUTOGENERATED NIRI CONFIG TRANSLATED FROM HYPRLAND
// #######################################################################################

environment {
    LIBVA_DRIVER_NAME "radeonsi"
    LIBVA_DRI3_DISABLE "1"
    XDG_CURRENT_DESKTOP "niri"
}

// ---------------------------------------------------------
// Monitors
// ---------------------------------------------------------
// External monitor on the left, laptop panel on the right (top-aligned)
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    position x=0 y=0
    scale 1.0
}

output "eDP-1" {
    mode "1920x1200@60.00100"
    position x=1920 y=0
    scale 1.0
}

// ---------------------------------------------------------
// Startup Executables
// ---------------------------------------------------------
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "hypridle"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "foot" "--server"
spawn-at-startup "sh" "-c" "xrdb -load ~/.Xresources"
spawn-at-startup "apply-gsettings"

// Clipboard manager
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"

// Wallpaper
spawn-at-startup "sh" "-c" "if command -v awww-daemon >/dev/null 2>&1; then awww-daemon; elif command -v swww-daemon >/dev/null 2>&1; then swww-daemon; fi"
spawn-at-startup "sh" "-c" "sleep 3 && ~/.local/bin/bing-daily.sh"

// ---------------------------------------------------------
// Input
// ---------------------------------------------------------
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt // Disable while typing
    }
    focus-follows-mouse
}

// ---------------------------------------------------------
// Layout and Decorations
// ---------------------------------------------------------
layout {
    gaps 1
    
    border {
        width 2
        active-gradient from="#33ccffee" to="#8f00ffee" angle=45
        inactive-color "#595959aa"
    }

    focus-ring {
        off
    }

    // Ensures the wallpaper daemon is rendered as a stationary background
    background-color "transparent"
}

animations {
    // Niri provides native fluid animations
    workspace-switch { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
    window-open { spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001; }
}

// ---------------------------------------------------------
// Rules (Layer and Window)
// ---------------------------------------------------------
layer-rule {
    match namespace="^wallpaper$" // Makes swww/awww stationary behind scrolling windows
    place-within-backdrop true
}

window-rule {
    match title="^(kitty)$"
    match title="^(calamares)$"
    open-floating true
}

window-rule {
    match title="^(thunar)$"
    match title="^(gedit)$"
    match title="^(catfish)$"
    opacity 0.85
}

// ---------------------------------------------------------
// Keybinds
// ---------------------------------------------------------
binds {
    // Mod keys setup (SUPER)
    Mod+Shift+R { spawn "niri" "msg" "action" "quit" "--skip-confirmation"; } // Note: Exits Niri (Niri live-reloads config automatically)
    Mod+Return { spawn "footclient"; }
    Mod+T { spawn "alacritty"; }
    Mod+Q { close-window; }
    Mod+Shift+E { spawn "wlogout"; }
    Mod+N { spawn "thunar"; }
    Mod+Shift+A { toggle-window-floating; } // 65 in your config is ASCII for 'A'
    Mod+Space { spawn "sh" "-c" "pkill wofi || wofi --normal-window --show drun --allow-images"; }
    Mod+E { spawn "emote"; }
    Mod+Shift+D { spawn "sh" "-c" "pkill wofi || wofi --show drun"; }
    Mod+V { spawn "sh" "-c" "cliphist list | wofi --dmenu | cliphist decode | wl-copy"; }

    // Media and Brightness (using standard XF86 keys rather than raw keycodes)
    XF86AudioLowerVolume { spawn "sh" "-c" "pamixer --decrease 5; notify-send ' Volume: '$(pamixer --get-volume) -t 500"; }
    XF86AudioRaiseVolume { spawn "sh" "-c" "pamixer --increase 5; notify-send ' Volume: '$(pamixer --get-volume) -t 500"; }
    XF86AudioMute { spawn "sh" "-c" "pamixer --toggle-mute; notify-send ' Volume: Toggle-mute' -t 500"; }
    XF86AudioMicMute { spawn "sh" "-c" "pactl set-source-mute @DEFAULT_SOURCE@ toggle; notify-send 'System Mic: Toggle-mute' -t 500"; }
    
    XF86MonBrightnessDown { spawn "brightnessctl" "-c" "backlight" "set" "5%-"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "-c" "backlight" "set" "+5%"; }
    
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }

    // Screenshots
    Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
    Ctrl+Print { spawn ".config/niri/scripts/screenshot_window.sh"; }
    Shift+Print { spawn ".config/niri/scripts/screenshot_display.sh"; }

    // Function Keys
    Mod+F1 { spawn "firedragon"; }
    Mod+F2 { spawn "thunderbird"; }
    Mod+F3 { spawn "thunar"; }
    Mod+F4 { spawn "geany"; }
    Mod+F5 { spawn "github-desktop"; }
    Mod+F6 { spawn "gparted"; }
    Mod+F7 { spawn "inkscape"; }
    Mod+F8 { spawn "blender"; }
    Mod+F9 { spawn "meld"; }
    Mod+F10 { spawn "joplin-desktop"; }
    Mod+F11 { spawn "snapper-tools"; }
    Mod+F12 { spawn "galculator"; }
    Mod+O { spawn "firedragon"; }

    // Fullscreen and Layout
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    
    // Focus moving (Left/Right moves between columns, Up/Down between windows in a column)
    Mod+Left { focus-column-left; }
    Mod+H { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+L { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+K { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+J { focus-window-down; }

    // Move windows
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+J { move-window-down; }

    // Resizing (Replaces the "resize" submap)
    Mod+Ctrl+Left { set-column-width "-5%"; }
    Mod+Ctrl+H { set-column-width "-5%"; }
    Mod+Ctrl+Right { set-column-width "+5%"; }
    Mod+Ctrl+L { set-column-width "+5%"; }
    Mod+Ctrl+Up { set-window-height "-5%"; }
    Mod+Ctrl+K { set-window-height "-5%"; }
    Mod+Ctrl+Down { set-window-height "+5%"; }
    Mod+Ctrl+J { set-window-height "+5%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Workspace scrolling (Replaces e+1 / e-1)
    Ctrl+Right { focus-workspace-down; }
    Ctrl+Left { focus-workspace-up; }
    Ctrl+Shift+Right { move-column-to-workspace-down; }
    Ctrl+Shift+Left { move-column-to-workspace-up; }
    // Mod+scroll moves across windows (columns), Mod+Shift+scroll switches workspace
    Mod+WheelScrollDown cooldown-ms=120 { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=120 { focus-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Special Workspace (Emulated using Workspace 99)
    Mod+Shift+S { move-column-to-workspace 99; }
}